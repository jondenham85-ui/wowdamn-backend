# WOWDamn Backend - Environment Variables
# Copy to .env and fill in your values. Never commit .env!

# Server
PORT=5000
NODE_ENV=production

# MongoDB (optional - falls back to mock data without it)
# Get a free cluster at https://mongodb.com/atlas
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/wowdamn?retryWrites=true&w=majority

# JWT Auth
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_string_at_least_64_chars

# CORS - Your Vercel frontend URL (no trailing slash)
FRONTEND_URL=https://wowdamn.vercel.app

# Rate Limiting
RATE_LIMIT_MAX=500
